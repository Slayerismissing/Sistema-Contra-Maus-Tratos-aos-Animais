-- ============================================================
-- 8. TRIGGERS PARA CAMPOS DE ATUALIZACAO
-- ============================================================

CREATE OR REPLACE FUNCTION atualizar_timestamp_modificacao()
RETURNS TRIGGER AS $$
BEGIN
    NEW.atualizado_em := CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_usuarios_atualizado_em
BEFORE UPDATE ON usuarios
FOR EACH ROW EXECUTE FUNCTION atualizar_timestamp_modificacao();

CREATE TRIGGER trg_denuncias_atualizado_em
BEFORE UPDATE ON denuncias
FOR EACH ROW EXECUTE FUNCTION atualizar_timestamp_modificacao();

CREATE TRIGGER trg_preferencias_atualizado_em
BEFORE UPDATE ON preferencias_notificacao
FOR EACH ROW EXECUTE FUNCTION atualizar_timestamp_modificacao();

CREATE TRIGGER trg_animais_atualizado_em
BEFORE UPDATE ON animais
FOR EACH ROW EXECUTE FUNCTION atualizar_timestamp_modificacao();

-- Historico e auditoria sao registros de inclusao: nao podem ser editados ou removidos.
CREATE OR REPLACE FUNCTION impedir_alteracao_historica()
RETURNS TRIGGER AS $$
BEGIN
    RAISE EXCEPTION 'Este registro e imutavel e nao pode ser alterado ou excluido.';
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_historico_denuncias_imutavel
BEFORE UPDATE OR DELETE ON historico_denuncias
FOR EACH ROW EXECUTE FUNCTION impedir_alteracao_historica();

CREATE TRIGGER trg_auditoria_imutavel
BEFORE UPDATE OR DELETE ON auditoria
FOR EACH ROW EXECUTE FUNCTION impedir_alteracao_historica();

-- Registros centrais devem ser inativados/arquivados, nunca apagados fisicamente.
CREATE OR REPLACE FUNCTION impedir_exclusao_fisica()
RETURNS TRIGGER AS $$
BEGIN
    RAISE EXCEPTION 'Exclusao fisica nao permitida. Utilize inativacao, ocultacao ou arquivamento.';
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_denuncias_sem_delete
BEFORE DELETE ON denuncias
FOR EACH ROW EXECUTE FUNCTION impedir_exclusao_fisica();

CREATE TRIGGER trg_usuarios_sem_delete
BEFORE DELETE ON usuarios
FOR EACH ROW EXECUTE FUNCTION impedir_exclusao_fisica();

CREATE TRIGGER trg_categorias_sem_delete
BEFORE DELETE ON categorias_denuncia
FOR EACH ROW EXECUTE FUNCTION impedir_exclusao_fisica();

CREATE TRIGGER trg_status_denuncia_sem_delete
BEFORE DELETE ON status_denuncia
FOR EACH ROW EXECUTE FUNCTION impedir_exclusao_fisica();

CREATE TRIGGER trg_animais_sem_delete
BEFORE DELETE ON animais
FOR EACH ROW EXECUTE FUNCTION impedir_exclusao_fisica();

-- ============================================================
-- 9. COMENTARIOS IMPORTANTES PARA A EQUIPE
-- ============================================================

COMMENT ON TABLE auditoria IS
    'Registro de auditoria. A aplicacao deve permitir somente inclusao e consulta.';
COMMENT ON TABLE historico_denuncias IS
    'Historico de status. Cada transicao deve ser gravada na mesma transacao da atualizacao da denuncia.';
COMMENT ON TABLE anexos IS
    'Metadados dos arquivos. Os binarios devem ficar em armazenamento privado fora do diretorio static.';
COMMENT ON TABLE fotos_animais IS
    'Metadados das fotos. Somente fotos ativas, aprovadas e autorizadas podem ser publicadas.';
COMMENT ON COLUMN denuncias.codigo_acompanhamento_hash IS
    'Armazenar somente hash do codigo sigiloso; o codigo original deve ser exibido uma unica vez ao denunciante.';
COMMENT ON COLUMN denuncias.usuario_id IS
    'Deve ser NULL para denuncias anonimas, inclusive quando existir sessao autenticada.';
COMMENT ON COLUMN auditoria.registro_id IS
    'Referencia polimorfica: a integridade do registro referenciado e validada pela aplicacao.';

COMMIT;

