-- Plataforma de Denuncia e Acompanhamento de Maus-Tratos a Animais
-- SGBD: PostgreSQL
-- Versao inicial: 17 tabelas (recuperacao de senha fora do escopo desta versao)
-- Execute conectado ao banco: plataforma_denuncias_animais
-- Este script deve ser executado uma vez em um banco vazio.

BEGIN;

-- ============================================================
-- 1. ACESSO: PERFIS E USUARIOS
-- ============================================================

CREATE TABLE perfis (
    id          SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome        VARCHAR(30) NOT NULL UNIQUE,
    descricao   TEXT,
    ativo       BOOLEAN NOT NULL DEFAULT TRUE
);

CREATE TABLE usuarios (
    id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome_completo   VARCHAR(150) NOT NULL,
    email           VARCHAR(254) NOT NULL,
    senha_hash      VARCHAR(255) NOT NULL,
    telefone        VARCHAR(20),
    perfil_id       SMALLINT NOT NULL,
    ativo           BOOLEAN NOT NULL DEFAULT TRUE,
    criado_em       TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em   TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_usuarios_perfis
        FOREIGN KEY (perfil_id) REFERENCES perfis (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_usuarios_nome
        CHECK (length(btrim(nome_completo)) > 0),
    CONSTRAINT ck_usuarios_email
        CHECK (length(btrim(email)) > 0)
);

-- E-mail unico sem diferenciar maiusculas/minusculas.
CREATE UNIQUE INDEX uq_usuarios_email_ci ON usuarios (lower(btrim(email)));
CREATE INDEX idx_usuarios_perfil_id ON usuarios (perfil_id);

-- ============================================================
-- 2. DENUNCIAS: CATEGORIAS, STATUS, DENUNCIAS E ENDERECOS
-- ============================================================

CREATE TABLE categorias_denuncia (
    id          SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome        VARCHAR(80) NOT NULL UNIQUE,
    descricao   TEXT,
    ativa       BOOLEAN NOT NULL DEFAULT TRUE,
    criada_em   TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT ck_categorias_denuncia_nome
        CHECK (length(btrim(nome)) > 0)
);

CREATE TABLE status_denuncia (
    id          SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome        VARCHAR(40) NOT NULL UNIQUE,
    descricao   TEXT,
    ordem       SMALLINT NOT NULL UNIQUE,
    ativo       BOOLEAN NOT NULL DEFAULT TRUE,
    criado_em   TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT ck_status_denuncia_nome
        CHECK (length(btrim(nome)) > 0),
    CONSTRAINT ck_status_denuncia_ordem
        CHECK (ordem > 0)
);

CREATE TABLE denuncias (
    id                          BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    protocolo                   VARCHAR(40) NOT NULL UNIQUE,
    codigo_acompanhamento_hash  CHAR(64) NOT NULL,
    descricao                   TEXT NOT NULL,
    categoria_id                SMALLINT NOT NULL,
    data_hora_ocorrencia        TIMESTAMP WITHOUT TIME ZONE,
    modo_envio                  SMALLINT NOT NULL,
    usuario_id                  BIGINT,
    status_id                   SMALLINT NOT NULL,
    responsavel_id              BIGINT,
    visibilidade                VARCHAR(15) NOT NULL DEFAULT 'RESTRITA',
    criado_em                   TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em               TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_denuncias_categoria
        FOREIGN KEY (categoria_id) REFERENCES categorias_denuncia (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_denuncias_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_denuncias_status
        FOREIGN KEY (status_id) REFERENCES status_denuncia (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_denuncias_responsavel
        FOREIGN KEY (responsavel_id) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT uq_denuncias_id_usuario UNIQUE (id, usuario_id),
    CONSTRAINT ck_denuncias_protocolo
        CHECK (length(btrim(protocolo)) > 0),
    CONSTRAINT ck_denuncias_codigo_hash
        CHECK (codigo_acompanhamento_hash ~ '^[0-9a-fA-F]{64}$'),
    CONSTRAINT ck_denuncias_descricao
        CHECK (length(btrim(descricao)) > 0),
    CONSTRAINT ck_denuncias_modo_envio
        CHECK (modo_envio IN (1, 2)),
    CONSTRAINT ck_denuncias_anonimato
        CHECK (
            (modo_envio = 1 AND usuario_id IS NULL)
            OR
            (modo_envio = 2 AND usuario_id IS NOT NULL)
        ),
    CONSTRAINT ck_denuncias_visibilidade
        CHECK (visibilidade IN ('PUBLICA', 'RESTRITA', 'OCULTA'))
);

CREATE TABLE enderecos_denuncia (
    denuncia_id BIGINT PRIMARY KEY,
    cep         VARCHAR(9) NOT NULL,
    logradouro  VARCHAR(150) NOT NULL,
    numero      VARCHAR(20),
    bairro      VARCHAR(100) NOT NULL,
    municipio   VARCHAR(100) NOT NULL,
    estado      CHAR(2) NOT NULL,
    complemento VARCHAR(120),

    CONSTRAINT fk_enderecos_denuncia_denuncia
        FOREIGN KEY (denuncia_id) REFERENCES denuncias (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_enderecos_cep
        CHECK (cep ~ '^[0-9]{5}-?[0-9]{3}$'),
    CONSTRAINT ck_enderecos_estado
        CHECK (estado ~ '^[A-Z]{2}$'),
    CONSTRAINT ck_enderecos_logradouro
        CHECK (length(btrim(logradouro)) > 0),
    CONSTRAINT ck_enderecos_bairro
        CHECK (length(btrim(bairro)) > 0),
    CONSTRAINT ck_enderecos_municipio
        CHECK (length(btrim(municipio)) > 0)
);

CREATE INDEX idx_denuncias_categoria_data
    ON denuncias (categoria_id, criado_em DESC);
CREATE INDEX idx_denuncias_status_data
    ON denuncias (status_id, criado_em DESC);
CREATE INDEX idx_denuncias_usuario_data
    ON denuncias (usuario_id, criado_em DESC)
    WHERE usuario_id IS NOT NULL;
CREATE INDEX idx_denuncias_responsavel_status
    ON denuncias (responsavel_id, status_id)
    WHERE responsavel_id IS NOT NULL;
CREATE INDEX idx_denuncias_criado_em ON denuncias (criado_em DESC);
CREATE INDEX idx_enderecos_municipio_estado
    ON enderecos_denuncia (municipio, estado);

-- ============================================================
-- 3. EVIDENCIAS E HISTORICO
-- ============================================================

CREATE TABLE anexos (
    id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    denuncia_id     BIGINT NOT NULL,
    nome_original   VARCHAR(255) NOT NULL,
    storage_key     UUID NOT NULL UNIQUE,
    tipo_mime       VARCHAR(100) NOT NULL,
    tamanho_bytes   BIGINT NOT NULL,
    hash_sha256     CHAR(64),
    status_analise  VARCHAR(15) NOT NULL DEFAULT 'PENDENTE',
    status_arquivo  VARCHAR(15) NOT NULL DEFAULT 'ATIVO',
    alterado_por    BIGINT,
    enviado_em      TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_anexos_denuncia
        FOREIGN KEY (denuncia_id) REFERENCES denuncias (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_anexos_alterado_por
        FOREIGN KEY (alterado_por) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_anexos_tamanho
        CHECK (tamanho_bytes > 0),
    CONSTRAINT ck_anexos_hash
        CHECK (hash_sha256 IS NULL OR hash_sha256 ~ '^[0-9a-fA-F]{64}$'),
    CONSTRAINT ck_anexos_status_analise
        CHECK (status_analise IN ('PENDENTE', 'APROVADO', 'QUARENTENA', 'REJEITADO')),
    CONSTRAINT ck_anexos_status_arquivo
        CHECK (status_arquivo IN ('ATIVO', 'OCULTADO', 'REMOVIDO'))
);

CREATE TABLE historico_denuncias (
    id                  BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    denuncia_id         BIGINT NOT NULL,
    status_anterior_id  SMALLINT,
    status_novo_id      SMALLINT NOT NULL,
    operador_id         BIGINT,
    justificativa_interna TEXT,
    resumo_publico      TEXT,
    criado_em           TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_historico_denuncia
        FOREIGN KEY (denuncia_id) REFERENCES denuncias (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_historico_status_anterior
        FOREIGN KEY (status_anterior_id) REFERENCES status_denuncia (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_historico_status_novo
        FOREIGN KEY (status_novo_id) REFERENCES status_denuncia (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_historico_operador
        FOREIGN KEY (operador_id) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_historico_status_diferente
        CHECK (status_anterior_id IS NULL OR status_anterior_id <> status_novo_id)
);

CREATE INDEX idx_anexos_denuncia ON anexos (denuncia_id);
CREATE INDEX idx_historico_denuncia_data
    ON historico_denuncias (denuncia_id, criado_em DESC);
CREATE INDEX idx_historico_operador_data
    ON historico_denuncias (operador_id, criado_em DESC)
    WHERE operador_id IS NOT NULL;

-- ============================================================
-- 4. COMUNICACAO E NOTIFICACOES
-- ============================================================

CREATE TABLE mensagens_denuncia (
    id                  BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    denuncia_id         BIGINT NOT NULL,
    autor_id            BIGINT NOT NULL,
    tipo_mensagem       VARCHAR(10) NOT NULL,
    canal               VARCHAR(10) NOT NULL DEFAULT 'SISTEMA',
    conteudo            TEXT NOT NULL,
    status_publicacao   VARCHAR(12) NOT NULL DEFAULT 'RASCUNHO',
    criada_em           TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    publicada_em        TIMESTAMPTZ,

    CONSTRAINT fk_mensagens_denuncia
        FOREIGN KEY (denuncia_id) REFERENCES denuncias (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_mensagens_autor
        FOREIGN KEY (autor_id) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_mensagens_tipo
        CHECK (tipo_mensagem IN ('PUBLICA', 'INTERNA')),
    CONSTRAINT ck_mensagens_canal
        CHECK (canal IN ('SISTEMA', 'EMAIL')),
    CONSTRAINT ck_mensagens_status
        CHECK (status_publicacao IN ('RASCUNHO', 'PUBLICADA', 'CANCELADA')),
    CONSTRAINT ck_mensagens_conteudo
        CHECK (length(btrim(conteudo)) > 0),
    CONSTRAINT ck_mensagens_publicacao
        CHECK (status_publicacao <> 'PUBLICADA' OR publicada_em IS NOT NULL),
    CONSTRAINT ck_mensagens_interna_sistema
        CHECK (tipo_mensagem <> 'INTERNA' OR canal = 'SISTEMA')
);

CREATE TABLE preferencias_notificacao (
    usuario_id                     BIGINT PRIMARY KEY,
    receber_email                  BOOLEAN NOT NULL DEFAULT TRUE,
    receber_sistema                BOOLEAN NOT NULL DEFAULT TRUE,
    notificar_alteracoes_status    BOOLEAN NOT NULL DEFAULT TRUE,
    criada_em                      TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizada_em                  TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_preferencias_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT
);

CREATE TABLE notificacoes (
    id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    usuario_id      BIGINT NOT NULL,
    denuncia_id     BIGINT NOT NULL,
    historico_id    BIGINT,
    mensagem_id     BIGINT,
    canal           VARCHAR(10) NOT NULL,
    titulo          VARCHAR(120) NOT NULL,
    conteudo        TEXT NOT NULL,
    status_envio    VARCHAR(10) NOT NULL DEFAULT 'PENDENTE',
    erro_envio      TEXT,
    criada_em       TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    enviada_em      TIMESTAMPTZ,
    lida_em         TIMESTAMPTZ,

    CONSTRAINT fk_notificacoes_usuario
        FOREIGN KEY (usuario_id) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    -- Garante que a notificacao pertence ao usuario vinculado a denuncia identificada.
    -- Denuncias anonimas (usuario_id NULL) nao podem gerar notificacoes vinculadas a uma conta.
    CONSTRAINT fk_notificacoes_denuncia_usuario
        FOREIGN KEY (denuncia_id, usuario_id) REFERENCES denuncias (id, usuario_id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_notificacoes_historico
        FOREIGN KEY (historico_id) REFERENCES historico_denuncias (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_notificacoes_mensagem
        FOREIGN KEY (mensagem_id) REFERENCES mensagens_denuncia (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_notificacoes_canal
        CHECK (canal IN ('SISTEMA', 'EMAIL')),
    CONSTRAINT ck_notificacoes_status
        CHECK (status_envio IN ('PENDENTE', 'ENVIADA', 'FALHA')),
    CONSTRAINT ck_notificacoes_titulo
        CHECK (length(btrim(titulo)) > 0),
    CONSTRAINT ck_notificacoes_conteudo
        CHECK (length(btrim(conteudo)) > 0),
    CONSTRAINT ck_notificacoes_enviada
        CHECK (status_envio <> 'ENVIADA' OR enviada_em IS NOT NULL),
    CONSTRAINT ck_notificacoes_leitura_sistema
        CHECK (canal = 'SISTEMA' OR lida_em IS NULL)
);

CREATE INDEX idx_mensagens_denuncia_data
    ON mensagens_denuncia (denuncia_id, criada_em DESC);
CREATE INDEX idx_notificacoes_usuario_data
    ON notificacoes (usuario_id, criada_em DESC);
CREATE INDEX idx_notificacoes_status_data
    ON notificacoes (status_envio, criada_em);

-- ============================================================
-- 5. ADOCAO DE ANIMAIS
-- ============================================================

CREATE TABLE status_adocao (
    id          SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome        VARCHAR(30) NOT NULL UNIQUE,
    descricao   TEXT,
    ativo       BOOLEAN NOT NULL DEFAULT TRUE,
    ordem       SMALLINT NOT NULL UNIQUE,

    CONSTRAINT ck_status_adocao_ordem CHECK (ordem > 0)
);

CREATE TABLE animais (
    id                  BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    identificacao_interna VARCHAR(40) NOT NULL UNIQUE,
    especie             VARCHAR(20) NOT NULL,
    porte               VARCHAR(15) NOT NULL,
    sexo                VARCHAR(15) NOT NULL,
    descricao_condicao  TEXT NOT NULL,
    localizacao_geral   VARCHAR(150) NOT NULL,
    status_adocao_id    SMALLINT NOT NULL,
    publicado           BOOLEAN NOT NULL DEFAULT FALSE,
    criado_por          BIGINT NOT NULL,
    atualizado_por      BIGINT,
    criado_em           TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em       TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_animais_status_adocao
        FOREIGN KEY (status_adocao_id) REFERENCES status_adocao (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_animais_criado_por
        FOREIGN KEY (criado_por) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_animais_atualizado_por
        FOREIGN KEY (atualizado_por) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_animais_especie
        CHECK (especie IN ('CAO', 'GATO', 'OUTROS')),
    CONSTRAINT ck_animais_porte
        CHECK (porte IN ('PEQUENO', 'MEDIO', 'GRANDE')),
    CONSTRAINT ck_animais_sexo
        CHECK (sexo IN ('MACHO', 'FEMEA', 'DESCONHECIDO')),
    CONSTRAINT ck_animais_descricao
        CHECK (length(btrim(descricao_condicao)) > 0)
);

CREATE TABLE fotos_animais (
    id                      BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    animal_id               BIGINT NOT NULL,
    nome_original           VARCHAR(255) NOT NULL,
    storage_key             UUID NOT NULL UNIQUE,
    tipo_mime               VARCHAR(100) NOT NULL,
    tamanho_bytes           BIGINT NOT NULL,
    hash_sha256             CHAR(64),
    status_analise          VARCHAR(15) NOT NULL DEFAULT 'PENDENTE',
    autorizada_publicacao   BOOLEAN NOT NULL DEFAULT FALSE,
    foto_principal          BOOLEAN NOT NULL DEFAULT FALSE,
    ativa                   BOOLEAN NOT NULL DEFAULT TRUE,
    enviada_por             BIGINT NOT NULL,
    enviada_em              TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_fotos_animais_animal
        FOREIGN KEY (animal_id) REFERENCES animais (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_fotos_animais_usuario
        FOREIGN KEY (enviada_por) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_fotos_animais_tamanho
        CHECK (tamanho_bytes > 0),
    CONSTRAINT ck_fotos_animais_hash
        CHECK (hash_sha256 IS NULL OR hash_sha256 ~ '^[0-9a-fA-F]{64}$'),
    CONSTRAINT ck_fotos_animais_status_analise
        CHECK (status_analise IN ('PENDENTE', 'APROVADO', 'QUARENTENA', 'REJEITADO')),
    CONSTRAINT ck_fotos_animais_principal
        CHECK (NOT foto_principal OR (ativa AND autorizada_publicacao AND status_analise = 'APROVADO'))
);

CREATE INDEX idx_animais_status_publicado
    ON animais (status_adocao_id, criado_em DESC)
    WHERE publicado = TRUE;
CREATE INDEX idx_fotos_animais_animal ON fotos_animais (animal_id);
CREATE UNIQUE INDEX uq_fotos_animais_principal
    ON fotos_animais (animal_id)
    WHERE foto_principal = TRUE AND ativa = TRUE
      AND autorizada_publicacao = TRUE AND status_analise = 'APROVADO';

-- ============================================================
-- 6. ADMINISTRACAO: AUDITORIA, MODERACAO E RELACIONAMENTOS
-- ============================================================

CREATE TABLE auditoria (
    id          BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    operador_id BIGINT,
    origem      VARCHAR(10) NOT NULL,
    acao        VARCHAR(60) NOT NULL,
    entidade    VARCHAR(50) NOT NULL,
    registro_id BIGINT NOT NULL,
    detalhes    JSONB,
    criado_em   TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_auditoria_operador
        FOREIGN KEY (operador_id) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_auditoria_origem
        CHECK (origem IN ('USUARIO', 'SISTEMA')),
    CONSTRAINT ck_auditoria_operador
        CHECK (
            (origem = 'USUARIO' AND operador_id IS NOT NULL)
            OR
            (origem = 'SISTEMA' AND operador_id IS NULL)
        ),
    CONSTRAINT ck_auditoria_acao
        CHECK (length(btrim(acao)) > 0),
    CONSTRAINT ck_auditoria_entidade
        CHECK (length(btrim(entidade)) > 0),
    CONSTRAINT ck_auditoria_registro
        CHECK (registro_id > 0)
);

CREATE TABLE moderacoes_denuncia (
    id                  BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    denuncia_id         BIGINT NOT NULL,
    moderador_id        BIGINT NOT NULL,
    acao                VARCHAR(15) NOT NULL,
    motivo              VARCHAR(40) NOT NULL,
    justificativa_interna TEXT,
    criado_em           TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_moderacoes_denuncia
        FOREIGN KEY (denuncia_id) REFERENCES denuncias (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_moderacoes_moderador
        FOREIGN KEY (moderador_id) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_moderacoes_acao
        CHECK (acao IN ('OCULTAR', 'RESTRINGIR', 'RESTAURAR')),
    CONSTRAINT ck_moderacoes_motivo
        CHECK (motivo IN (
            'DADOS_PESSOAIS_EXCESSIVOS',
            'CONTEUDO_ILEGAL',
            'AMEACAS',
            'SPAM',
            'MATERIAL_NAO_RELACIONADO'
        ))
);

CREATE TABLE denuncias_relacionadas (
    id                      BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    denuncia_principal_id   BIGINT NOT NULL,
    denuncia_secundaria_id  BIGINT NOT NULL,
    vinculado_por           BIGINT NOT NULL,
    motivo_vinculo          TEXT,
    criado_em               TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    ativo                   BOOLEAN NOT NULL DEFAULT TRUE,
    desvinculado_por        BIGINT,
    desvinculado_em         TIMESTAMPTZ,

    CONSTRAINT fk_relacionadas_principal
        FOREIGN KEY (denuncia_principal_id) REFERENCES denuncias (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_relacionadas_secundaria
        FOREIGN KEY (denuncia_secundaria_id) REFERENCES denuncias (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_relacionadas_vinculado_por
        FOREIGN KEY (vinculado_por) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT fk_relacionadas_desvinculado_por
        FOREIGN KEY (desvinculado_por) REFERENCES usuarios (id)
        ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT ck_relacionadas_diferentes
        CHECK (denuncia_principal_id <> denuncia_secundaria_id),
    CONSTRAINT ck_relacionadas_estado
        CHECK (
            (ativo = TRUE AND desvinculado_por IS NULL AND desvinculado_em IS NULL)
            OR
            (ativo = FALSE AND desvinculado_por IS NOT NULL AND desvinculado_em IS NOT NULL)
        )
);

CREATE UNIQUE INDEX uq_denuncia_secundaria_ativa
    ON denuncias_relacionadas (denuncia_secundaria_id)
    WHERE ativo = TRUE;
CREATE INDEX idx_denuncias_relacionadas_principal
    ON denuncias_relacionadas (denuncia_principal_id)
    WHERE ativo = TRUE;
CREATE INDEX idx_moderacoes_denuncia_data
    ON moderacoes_denuncia (denuncia_id, criado_em DESC);
CREATE INDEX idx_auditoria_operador_data
    ON auditoria (operador_id, criado_em DESC)
    WHERE operador_id IS NOT NULL;
CREATE INDEX idx_auditoria_entidade_registro
    ON auditoria (entidade, registro_id, criado_em DESC);

-- ============================================================
-- 7. DADOS INICIAIS (TABELAS DE DOMINIO)
-- ============================================================

INSERT INTO perfis (id, nome, descricao) VALUES
    (1, 'USUARIO_COMUM', 'Usuário que pode realizar e acompanhar denúncias identificadas.'),
    (2, 'ADMINISTRADOR', 'Perfil administrativo com permissões de gestão.'),
    (3, 'MODERADOR', 'Perfil autorizado a moderar conteúdos e apoiar a triagem.');

INSERT INTO categorias_denuncia (id, nome, descricao) VALUES
    (1, 'Agressão física', 'Suspeita ou ocorrência de agressão física contra animal.'),
    (2, 'Abandono', 'Suspeita ou ocorrência de abandono de animal.'),
    (3, 'Negligência', 'Ausência de cuidados essenciais ao animal.'),
    (4, 'Confinamento/Acorrentamento', 'Confinamento ou acorrentamento inadequado.'),
    (5, 'Condições insalubres', 'Animal mantido em ambiente sem condições adequadas de higiene.'),
    (6, 'Rinhas/Exploração', 'Suspeita de rinhas ou exploração de animais.'),
    (7, 'Outros', 'Ocorrências não enquadradas nas categorias anteriores.');

INSERT INTO status_denuncia (id, nome, descricao, ordem) VALUES
    (1, 'Recebida', 'Denúncia registrada na plataforma.', 1),
    (2, 'Em triagem', 'Denúncia aguardando ou passando por triagem.', 2),
    (3, 'Em análise', 'Denúncia em avaliação pela equipe responsável.', 3),
    (4, 'Encaminhada', 'Denúncia encaminhada ao órgão ou setor competente.', 4),
    (5, 'Em atendimento', 'Providências relacionadas à denúncia estão em andamento.', 5),
    (6, 'Concluída', 'Atendimento da denúncia concluído.', 6),
    (7, 'Arquivada', 'Denúncia arquivada pela equipe autorizada.', 7);

